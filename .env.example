# Скопіюйте у .env і заповніть. Файл .env не комітьте!

# Сервер
PORT=3000
NODE_ENV=production
# Публічна адреса сайту без слеша в кінці (canonical, Open Graph, sitemap, посилання в Telegram)
SITE_URL=https://your-domain.cz
# Шлях до бази SQLite (відносно папки проєкту). На Render вкажіть шлях на диску: /var/data/bookings.db
DB_PATH=./data/bookings.db
# За реверс-проксі (Render, nginx, Cloudflare) — 1, щоб rate limit бачив реальні IP
TRUST_PROXY=1
# Додаткові домени, яким дозволено звертатися до API (через кому). Зазвичай порожньо.
CORS_ORIGINS=

# Адмінка /admin
# Пароль мінімум 8 символів. Без нього адмінка вимкнена.
ADMIN_PASSWORD=
# Довгий випадковий рядок для підпису сесії, напр.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Сповіщення в Telegram (необовʼязково)
# 1) Створіть бота в @BotFather → токен. 2) Напишіть боту /start. 3) chat_id: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Сповіщення на email через SMTP (необовʼязково). Для Gmail — пароль застосунку.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
