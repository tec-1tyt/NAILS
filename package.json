{
  "name": "nailsby-nstjky",
  "version": "1.0.0",
  "private": true,
  "description": "Сайт майстрині манікюру nailsby.nstjky (Прага): лендінг, онлайн-запис, адмін-панель.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "node scripts/build.mjs --demo --base=/nails-demo/ --out=dist-demo",
    "preview:demo": "node scripts/build.mjs --demo --base=/nails-demo/ --out=dist-demo && node scripts/serve-static.mjs dist-demo nails-demo",
    "start": "node server/index.js",
    "dev": "node scripts/build.mjs && node --watch server/index.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "nodemailer": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  }
}
